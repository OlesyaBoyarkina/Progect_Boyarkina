v1 = float(input("Скорость 1 авто: "))
v2 = float(input("Скорость 2 авто: "))
s = float(input("Начальное расстояние: "))
t = float(input("Время в пути: "))

v_obshaya = v1 + v2

put = v_obshaya * t

if s > put:
result = s - put
else:
result = put - s

print("Расстояние через", t, "часов:", result)

