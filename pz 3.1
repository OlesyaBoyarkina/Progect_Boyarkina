def check_inequalities():
    print(«— Задание 1: Проверка неравенств —«)
    while True:
        try:
            a = int(input(«Введите целое число A: «))
            b = int(input(«Введите целое число B: «))

            # Проверяем условие: A > 0 ИЛИ B < -2
            if a > 0 or b < -2:
                print(«Истина: условие (A > 0 или B < -2) выполняется.»)
            else:
                print(«Ложь: условие не выполняется.»)
            break

        except ValueError:
            print(«Ошибка: вводите целые числа, а не буквы. Попробуйте снова.»)
            
