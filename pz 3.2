def get_card_name():
    print(«\n— Задание 2: Название карты —«)
    
    # Словари для перевода номеров в слова
    suits = {1: «пик», 2: «треф», 3: «бубен», 4: «червей»}
    ranks = {
        11: «валет», 12: «дама», 13: «король», 14: «туз»
    }

    while True:
        try:
            number = int(input(«Введите трёхзначное число (например, 412 для дамы червей): «))
            
            # Проверка, что число трехзначное
            if not (100 <= number <= 999):
                print(«Ошибка: нужно ввести именно трёхзначное число.»)
                continue
                
            # Извлекаем цифры
            suit_code = number // 100        # Первая цифра
            rank_code = number % 100         # Последние две цифры
            
            # Проверяем, что введенные коды существуют в словарях
            if suit_code not in suits:
                print(«Ошибка: масть должна быть от 1 до 4.»)
                continue
            
            if rank_code not in ranks:
                print(«Ошибка: достоинство должно быть от 11 до 14.»)
                continue
                
            # Формируем результат
            card_name = f»{ranks[rank_code]} {suits[suit_code]}»
            print(f»Ваша карта: {card_name}»)
            break
            
        except ValueError:
            print(«Ошибка: введите целое число, а не буквы. Попробуйте снова.»)


